# Copy to .env and fill in what you use. All of these are free; none need a card.
# The copilot reads .env automatically. Never commit .env.

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (or openai/gpt-oss-20b)

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (':free' models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama runs locally, no key: https://ollama.com  (then `ollama pull llama3.1:8b`)
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Seconds between hosted API calls (defaults: groq 15, gemini 5, openrouter 4)
# COPILOT_MIN_INTERVAL_S=15
